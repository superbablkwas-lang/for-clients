local function autoSkipLoading()
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not pGui then return end
    for _, gui in ipairs(pGui:GetChildren()) do
        if gui:IsA("ScreenGui") and gui.Name ~= "YBA_AutoFarm_HUD" then
            for _, obj in ipairs(gui:GetDescendants()) do
                if obj:IsA("GuiButton") then
                    local txt = string.lower(obj.Text or "")
                    if string.find(txt, "play") or string.find(txt, "start") then
                        if firesignal then
                            pcall(firesignal, obj.Activated)
                            pcall(firesignal, obj.MouseButton1Click)
                        end
                        task.wait(0.2)
                    end
                end
            end
        end
    end
end

-- ============================================================================
-- 5. КОНТЕЙНЕР
-- ============================================================================
local CachedContainer, ContainerMissTime = nil, 0

local function getItemContainer()
    if CachedContainer and CachedContainer.Parent then
        return CachedContainer
    end
    CachedContainer = nil

    local spawns = Workspace:FindFirstChild("Item_Spawns")
    if spawns then
        local items = spawns:FindFirstChild("Items")
        if items then
            CachedContainer = items
            return items
        end
    end

    if os.clock() - ContainerMissTime < Config.ContainerMissTTL then
        return nil
    end
    ContainerMissTime = os.clock()

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == "Items" and (desc:IsA("Folder") or desc:IsA("Model")) then
            local looksLikeItems = false
            for _, child in ipairs(desc:GetChildren()) do
                if child:IsA("Model") then
                    local hasMesh, hasPrompt = false, false
                    for _, sub in ipairs(child:GetDescendants()) do
                        if sub:IsA("MeshPart") or sub:IsA("BasePart") then hasMesh = true end
                        if sub:IsA("ProximityPrompt") then hasPrompt = true end
                        if hasMesh and hasPrompt then break end
                    end
                    if hasMesh and hasPrompt then
                        looksLikeItems = true
                        break
                    end
                end
            end
            if looksLikeItems then
                CachedContainer = desc
                return desc
            end
        end
    end
    return nil
end

-- ============================================================================
-- 6. СБОР
-- ============================================================================
local Collected = setmetatable({}, {__mode = "k"})
local CollectFails = setmetatable({}, {__mode = "k"})

local function getProximityPrompt(model)
    if not model then return nil end
    return model:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function shouldCollectItem(model)
    if not model or not model:IsA("Model") then return false end
    if Collected[model] then return false end
    if (CollectFails[model] or 0) >= Config.MaxCollectFails then return false end
    if not getProximityPrompt(model) then return false end
    return true
end

local function collectItem(model)
    if not model or not model.Parent or Collected[model] then return false end

    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local part = model:FindFirstChildWhichIsA("MeshPart") or model:FindFirstChildWhichIsA("BasePart")
    if not part then return false end

    root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
    task.wait(0.5)

    local prox = getProximityPrompt(model)
    if not prox then return false end

    local fired = false
    pcall(function()
        if fireproximityprompt then
            fireproximityprompt(prox)
            fired = true
        elseif firesignal then
            firesignal(prox.Triggered)
            fired = true
        end
    end)
    task.wait(0.3)

    if fired then
        Collected[model] = true
        return true
    end

    CollectFails[model] = (CollectFails[model] or 0) + 1
    return false
end

-- ============================================================================
-- 7. ПРОДАЖА
-- ============================================================================
local function tryInvoke(remote, ...)
    if not remote then return false end
    local args = {...}
    if remote:IsA("RemoteFunction") then
        return (pcall(function() return remote:InvokeServer(unpack(args)) end))
    elseif remote:IsA("RemoteEvent") then
        return (pcall(function() remote:FireServer(unpack(args)) end))
    end
    return (pcall(function() remote:InvokeServer(unpack(args)) end))
end

local function sellAllSellable()
    if FSM.Selling then return end
    FSM.Selling = true

    local ok, err = pcall(function()
        local sellRemote = getSellRemote()
        if not sellRemote then return end
        local backpack = LocalPlayer:FindFirstChild("Backpack")
        if not backpack then return end

        for _, tool in ipairs(backpack:GetChildren()) do
            if not isActive() then break end
            if tool:IsA("Tool") and not Config.KeepItems[tool.Name] then
                if not tryInvoke(sellRemote, tool) then
                    tryInvoke(sellRemote, tool.Name)
                end
                task.wait(Config.ActionDelay)
            end
        end
    end)

    FSM.Selling = false
    if not ok then logStatus("Sell err: " .. tostring(err)) end
end

