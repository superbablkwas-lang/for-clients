local CachedRemotes = nil
local function findRemotesFolder()
    if CachedRemotes and CachedRemotes.Parent then return CachedRemotes end
    local candidates = {
        ReplicatedStorage:FindFirstChild("Remotes"),
        ReplicatedStorage:FindFirstChild("GameEvents"),
        ReplicatedStorage:FindFirstChild("RemoteEvents"),
    }
    for _, folder in ipairs(candidates) do
        if folder then
            CachedRemotes = folder
            return folder
        end
    end
    return nil
end

local RemoteMissCache = {}
local function getRemoteAny(names)
    local folder = findRemotesFolder()
    if not folder then
        logStatus("Не найдена папка с ремоутами")
        return nil
    end
    for _, name in ipairs(names) do
        local rem = folder:FindFirstChild(name) or folder:FindFirstChild(name, true)
        if rem then
            RemoteMissCache[name] = nil
            return rem
        end
    end
    local now = os.clock()
    for _, name in ipairs(names) do
        local last = RemoteMissCache[name]
        if not last or (now - last) > Config.RemoteCacheTTL then
            RemoteMissCache[name] = now
            logStatus("Ремот не найден: " .. name)
            break
        end
    end
    return nil
end

local function getSellRemote()
    return getRemoteAny({"Sell_Item", "SellItem", "SellInventory", "Sell"})
end
local function getBuyRemote()
    return getRemoteAny({"BuyItem", "Purchase", "Buy"})
end

