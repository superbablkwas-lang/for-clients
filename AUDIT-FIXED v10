local function countLuckyArrows()
    local n = 0
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        for _, it in ipairs(bp:GetChildren()) do
            if it.Name == "Lucky Arrow" then n = n + 1 end
        end
    end
    local ch = LocalPlayer.Character
    if ch then
        for _, it in ipairs(ch:GetChildren()) do
            if it.Name == "Lucky Arrow" then n = n + 1 end
        end
    end
    return n
end

local function buyLuckyArrow()
    if FSM.Buying then return end
    local before = countLuckyArrows()
    if before >= Config.MaxLuckyArrows then return end

    FSM.Buying = true
    local ok, err = pcall(function()
        local buyRemote = getBuyRemote()
        if not buyRemote then return end
        local variants = {"Lucky Arrow", "LuckyArrow", "Lucky_Arrow"}
        for _, arg in ipairs(variants) do
            if not isActive() then break end
            tryInvoke(buyRemote, arg)
            task.wait(0.4)
            if countLuckyArrows() > before then return end
        end
    end)
    FSM.Buying = false
    if not ok then logStatus("Buy err: " .. tostring(err)) end
end

-- ============================================================================
-- [V10-1] Проверка: есть ли в Backpack вещи, которые можно продать
-- (исключая KeepItems — Lucky Arrow / Lucky Stone Mask)
-- ============================================================================
local function hasSellableItemsInBackpack()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if not bp then return false end
    for _, tool in ipairs(bp:GetChildren()) do
        if tool:IsA("Tool") and not Config.KeepItems[tool.Name] then
            return true
        end
    end
    return false
end

-- ============================================================================
-- 9. HTTP + SERVER HOP
-- ============================================================================
local function httpGet(url)
    if type(HttpGet) == "function" then
        local ok, res = pcall(HttpGet, url)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    if typeof(request) == "function" then
        local ok, res = pcall(request, {Url = url, Method = "GET"})
        if ok and res and res.Success and res.Body then return res.Body end
    end
    if syn and type(syn.request) == "function" then
        local ok, res = pcall(syn.request, {Url = url, Method = "GET"})
        if ok and res and res.Success and res.Body then return res.Body end
    end
    if type(game.HttpGet) == "function" then
        local ok, res = pcall(function() return game:HttpGet(url) end)
        if ok and type(res) == "string" and #res > 0 then return res end
    end
    return nil
end

local function armAutoRestart()
    if type(queue_on_teleport) ~= "function" then return false end
    if type(readfile) ~= "function" or type(isfile) ~= "function" then return false end
    local queued = false
    pcall(function()
        if isfile(Config.HopSourcePath) then
            local src = readfile(Config.HopSourcePath)
            if type(src) == "string" and #src > 100 then
                queue_on_teleport(src)
                queued = true
            end
        end
    end)
    return queued
end

local function serverHop()
    if not Config.EnableHop then
        logStatus("Server Hop выключен (EnableHop=false)")
        return
    end
    if os.clock() - FSM.LastHop < Config.HopCooldown then
        logStatus(string.format("Cooldown hop: %ds", math.floor(Config.HopCooldown - (os.clock() - FSM.LastHop))))
        return
    end

    logStatus("Server Hop...")
    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        game.PlaceId
    )
    local body = httpGet(url)
    if not body then
        logStatus("HTTP недоступен")
        return
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if not ok or not data or not data.data then
        logStatus("Не удалось распарсить список серверов")
        return
    end
    for _, srv in ipairs(data.data) do
        if srv.id ~= game.JobId and (tonumber(srv.playing) or 0) < (tonumber(srv.maxPlayers) or 0) then
            FSM.LastHop = os.clock()

            local canRestart = armAutoRestart()
            if not canRestart then
                logStatus("Hop без авто-рестарта — перезапусти скрипт вручную")
                task.wait(1.5)
                if not isActive() then
                    warn("[YBA] Hop отменён — скрипт остановлен")
                    return
                end
            end

            if not isActive() then
                warn("[YBA] Hop отменён — скрипт остановлен")
                return
            end

            pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, srv.id, LocalPlayer)
            end)
            return
        end
    end
    logStatus("Свободных серверов не найдено")
end

-- ============================================================================
-- 10. ГЛАВНЫЙ ЦИКЛ
-- ============================================================================
local function hasCollectibleInContainer(container)
    if not container then return false end
    for _, m in ipairs(container:GetChildren()) do
        if shouldCollectItem(m) then return true end
    end
    return false
end

local function mainLoop()
    while isActive() do
        task.wait(0.1)
        if not isActive() then break end

        local ok, err = pcall(function()
            if os.clock() - FSM.LastAutoSkip > Config.AutoSkipRateLimit then
                FSM.LastAutoSkip = os.clock()
                autoSkipLoading()
            end

            if not HUDLabel or not HUDLabel.Parent then
                ensureHudAsync()
            end

            local container = getItemContainer()

            if container then
                for _, model in ipairs(container:GetChildren()) do
                    if not isActive() then break end
                    if shouldCollectItem(model) then
                        logStatus("Подбираем: " .. model.Name)
                        collectItem(model)
                        task.wait(Config.ActionDelay)
                    end
                end
            end

            local hasCollectible = hasCollectibleInContainer(container)
            if hasCollectible then
                FSM.LastItemSeen = os.clock()
            end

            if os.clock() - FSM.LastSell > Config.SellInterval then
                FSM.LastSell = os.clock()
                task.spawn(function() sellAllSellable() end)
            end

            if os.clock() - FSM.LastBuy > Config.BuyInterval then
                FSM.LastBuy = os.clock()
                task.spawn(function() buyLuckyArrow() end)
            end

            -- [V10-2] Hop: только после сбора И продажи
            if Config.EnableHop then
                if not hasCollectible and (os.clock() - FSM.LastItemSeen > Config.HopEmptyGrace) then

                    -- Принудительная продажа перед хопом (rate-limited, чтобы не спамить)
                    if hasSellableItemsInBackpack() and not FSM.Selling
                       and (os.clock() - FSM.LastHopSellAttempt > Config.HopSellRetryInterval) then
                        FSM.LastHopSellAttempt = os.clock()
                        logStatus("Продажа перед хопом...")
                        sellAllSellable()          -- синхронный вызов, скрипт подождёт
                        FSM.LastSell = os.clock()  -- сбросить таймер регулярной продажи
                    end

                    -- Хопаем ТОЛЬКО если бэкпак пуст и продажа не идёт прямо сейчас
                    if not hasSellableItemsInBackpack() and not FSM.Selling then
                        serverHop()
                        FSM.LastItemSeen = os.clock()
                    end
                end
            end
        end)

        if not ok then
            local now = os.clock()
            if now - FSM.LastLoopErr > Config.ErrorLogTTL then
                FSM.LastLoopErr = now
                logStatus("Loop err: " .. tostring(err))
            end
        end
    end
    logStatus("Цикл завершён")
end

