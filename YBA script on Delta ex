            BuyLuckyArrows()
            task.wait(1.0)

            -- 6. Server Hop через промежуточный плейс
            PerformDeltaServerHop()
        end)

        if not cycleOk then
            UI:Log("Сбой цикла: " .. tostring(cycleErr))
            task.wait(2.0)
            PerformDeltaServerHop()
        end

        task.wait(1.5)
    end
end)
