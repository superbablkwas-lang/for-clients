-- // ЭТАП 1 & 2: ПРОПУСК ЭКРАНА ЗАГРУЗКИ И НАЖАТИЕ PLAY //
local function HandleLoadingAndPlay()
    UI:SetStatus("Пропуск загрузки...")
    UI:Log("Ожидание загрузки и кнопки Play...")

    local maxWaitTime = 45
    local startTime = os.clock()

    while os.clock() - startTime < maxWaitTime do
        local isReady = false

        pcall(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")

            local inMenu = false
            if playerGui then
                local loadingScreen = playerGui:FindFirstChild("LoadingScreen") or playerGui:FindFirstChild("LoadingScreen1")
                if loadingScreen then
                    inMenu = true
                    for _, btn in ipairs(loadingScreen:GetDescendants()) do
                        if btn:IsA("TextButton") and btn.Visible then
                            TriggerGuiButton(btn)
                        end
                    end
                end

                for _, gui in ipairs(playerGui:GetDescendants()) do
                    if gui:IsA("TextButton") and gui.Visible then
                        local txt = string.lower(gui.Text or "")
                        local name = string.lower(gui.Name or "")
                        if string.find(txt, "skip") or string.find(name, "skip") then
                            inMenu = true
                            UI:SetStatus("Пропуск загрузки...")
                            TriggerGuiButton(gui)
                            UI:Log("Нажата кнопка Skip")
                            task.wait(0.35)
                        elseif txt == "play" or string.find(txt, "play") or name == "play" or string.find(name, "playbutton") then
                            inMenu = true
                            UI:SetStatus("Нажатие Play...")
                            TriggerGuiButton(gui)
                            UI:Log("Нажата кнопка Play")
                            task.wait(0.45)
                        end
                    end
                end
            end

            if not hrp or inMenu then
                SendYBARemote("Event", "PressedPlay")
            end

            if hrp and not inMenu and (os.clock() - startTime > 4) then
                UI:Log("Персонаж загружен на сервер.")
                isReady = true
            end
        end)

        if isReady then
            break
        end

        task.wait(0.5)
    end
end

-- // ЭТАП 3: АВТОМАТИЧЕСКИЙ СБОР ПРЕДМЕТОВ С ПОЛА (ДВОЙНОЙ МЕТОД ДЛЯ ANDROID) //
local function CollectGroundItems()
    UI:SetStatus("Сбор предметов...")
    UI:Log("Сканирование спавнов предметов...")

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local hrp = char:WaitForChild("HumanoidRootPart", 10)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hrp or not hum then
        UI:Log("Ошибка: Персонаж не готов")
        return
    end

    local targets = {}

    pcall(function()
        local itemContainer = workspace:FindFirstChild("Item_Spawns")
        if itemContainer and itemContainer:FindFirstChild("Items") then
            itemContainer = itemContainer.Items
        end

        local function ScanContainer(parent)
            if not parent then return end
            for _, obj in ipairs(parent:GetChildren()) do
                pcall(function()
                    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
                    local clicker = obj:FindFirstChildWhichIsA("ClickDetector", true)
                    local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)

                    if part and (prompt or clicker) then
                        local mesh = obj:FindFirstChildWhichIsA("MeshPart", true) or part
                        if mesh.Transparency < 1 then
                            table.insert(targets, {
                                Model = obj,
                                Part = part,
                                Prompt = prompt,
                                Clicker = clicker
                            })
                        end
                    end
                end)
            end
        end

        if itemContainer then
            ScanContainer(itemContainer)
        else
            for _, desc in ipairs(workspace:GetDescendants()) do
                if desc:IsA("ProximityPrompt") and desc.Parent and desc.Parent:IsA("BasePart") then
                    local model = desc:FindFirstAncestorOfClass("Model")
                    if model and not Players:GetPlayerFromCharacter(model) then
                        table.insert(targets, {
                            Model = model,
                            Part = desc.Parent,
                            Prompt = desc,
                            Clicker = model:FindFirstChildWhichIsA("ClickDetector", true)
                        })
                    end
                end
            end
        end
    end)

    UI:Log("Найдено предметов: " .. tostring(#targets))

    for _, itemData in ipairs(targets) do
        if not itemData.Model or not itemData.Model.Parent or not itemData.Part then
            continue
        end

        char = LocalPlayer.Character
        hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then break end

        local beforeTotal = 0
        pcall(function()
            beforeTotal = #LocalPlayer.Backpack:GetChildren() + #char:GetChildren()
        end)

        pcall(function()
            hrp.Velocity = Vector3.zero
            hrp.CFrame = itemData.Part.CFrame + env.YBA_Config.TeleportOffset
        end)

        task.wait(env.YBA_Config.ScanInterval)

        -- ИСПРАВЛЕНИЕ 4: Двойной метод сбора предметов (fireproximityprompt + InputHoldBegin/End)
        pcall(function()
            if itemData.Prompt and itemData.Prompt.Enabled then
                if fireproximityprompt then
                    fireproximityprompt(itemData.Prompt)
                end
                if itemData.Model.Parent then
                    itemData.Prompt:InputHoldBegin()
                    task.wait(itemData.Prompt.HoldDuration + 0.12)
                    itemData.Prompt:InputHoldEnd()
                end
            end
            if itemData.Clicker and fireclickdetector then
                fireclickdetector(itemData.Clicker)
            end
        end)

        task.wait(0.3)

        local afterTotal = 0
        pcall(function()
            afterTotal = #LocalPlayer.Backpack:GetChildren() + #char:GetChildren()
        end)

        if afterTotal > beforeTotal then
            env.YBA_Stats.Collected = env.YBA_Stats.Collected + (afterTotal - beforeTotal)
            UI:UpdateStats()
            UI:Log("Подобран предмет!")
        end
    end
end

-- // ЭТАП 4: АВТОМАТИЧЕСКАЯ ПРОДАЖА ПРЕДМЕТОВ (СТРОГАЯ ПРОВЕРКА tool.Parent == nil) //
local function SellCollectedItems()
    UI:SetStatus("Продажа...")
    UI:Log("Продажа собранных предметов...")

    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not char or not hum or not backpack then return end

    local sellableLookup = {}
    for _, name in ipairs(env.YBA_Config.SellableItems) do
        sellableLookup[name] = true
    end

    local toolsToProcess = {}
    pcall(function()
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(toolsToProcess, tool)
            end
        end
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then
                table.insert(toolsToProcess, tool)
            end
        end
    end)

    for _, tool in ipairs(toolsToProcess) do
        if tool and tool.Parent then
            local itemName = tool.Name
            -- Никогда не продаем Lucky Arrow, Lucky Stone Mask и др. из KeepItems
            if not env.YBA_Config.KeepItems[itemName] and sellableLookup[itemName] then
                pcall(function()
                    -- Экипируем предмет в руки персонажа
                    if tool.Parent ~= char then
                        hum:EquipTool(tool)
                        task.wait(0.3)
                    end

                    -- Отправляем пакет продажи торговцу ShiftPlox (Merchant -> Option1 -> Dialogue5)
                    if tool.Parent == char then
                        local args = {
                            [1] = "EndDialogue",
                            [2] = {
                                ["NPC"] = "Merchant",
                                ["Option"] = "Option1",
                                ["Dialogue"] = "Dialogue5"
                            }
                        }
                        char.RemoteEvent:FireServer(unpack(args))
                        task.wait(0.35)
                    end
                end)

                -- ИСПРАВЛЕНИЕ 2: Строгая проверка `if tool.Parent == nil then`
                -- Предмет должен полностью исчезнуть из игры после продажи
                if tool.Parent == nil then
                    env.YBA_Stats.Sold = env.YBA_Stats.Sold + 1
                    UI:UpdateStats()
                    UI:Log("Продано: " .. itemName)
                else
                    -- Если предмет остался в Character или Backpack — снимаем его с рук и НЕ увеличиваем счётчик
                    pcall(function()
                        hum:UnequipTools()
                    end)
                end
            end
        end
    end

    pcall(function()
        hum:UnequipTools()
    end)
end

-- // ЭТАП 5: ПОКУПКА LUCKY ARROW (ТОЛЬКО ЧЕРЕЗ ЭМУЛЯЦИЮ GUI PLAYERGUI -> HUD -> SHOP) //
local function BuyLuckyArrows()
    UI:SetStatus("Покупка Lucky Arrow...")

    local currentLucky = CountItemInInventory("Lucky Arrow")
    if currentLucky >= env.YBA_Config.MaxLuckyArrows then
        UI:Log("Лимит Lucky Arrow (9/9) достигнут.")
        return
    end

    -- ИСПРАВЛЕНИЕ 1: Полностью удалены несуществующие RemoteEvent.
    -- Покупка осуществляется исключительно через навигацию и нажатие кнопок в PlayerGui -> HUD -> Shop.
    local function TryBuyViaShopGUI()
        local clickedPurchase = false

        pcall(function()
            local pGui = LocalPlayer:FindFirstChild("PlayerGui")
            if not pGui then return end

            local hud = pGui:FindFirstChild("HUD") or pGui

            -- 1. Открываем магазин через HUD -> Shop (если вкладка магазина еще не открыта)
            for _, desc in ipairs(hud:GetDescendants()) do
                pcall(function()
                    if desc:IsA("GuiButton") and desc.Visible then
                        local bName = string.lower(desc.Name or "")
                        local bText = desc:IsA("TextButton") and string.lower(desc.Text or "") or ""
                        if bName == "shop" or string.find(bName, "shopbutton") or bText == "shop" then
                            TriggerGuiButton(desc)
                            task.wait(0.25)
                        end
                    end
                end)
            end

            -- 2. Ищем карточку Lucky Arrow в открытом магазине по тексту "Lucky Arrow", "75,000" или "75000"
            for _, obj in ipairs(hud:GetDescendants()) do
                pcall(function()
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                        local txt = string.lower(obj.Text or "")
                        local name = string.lower(obj.Name or "")

                        if string.find(txt, "lucky arrow") or string.find(name, "lucky arrow") or string.find(txt, "75,000") or string.find(txt, "75000") then
                            -- Нажимаем саму карточку, если это кнопка
                            if obj:IsA("GuiButton") and obj.Visible then
                                TriggerGuiButton(obj)
                                clickedPurchase = true
                                task.wait(0.2)
                            end

                            -- Ищем кнопки покупки внутри контейнера карточки (Parent и Parent.Parent)
                            local container = obj.Parent
                            if container then
                                for _, child in ipairs(container:GetDescendants()) do
                                    if child:IsA("GuiButton") and child.Visible then
                                        TriggerGuiButton(child)
                                        clickedPurchase = true
                                        task.wait(0.2)
                                    end
                                end
                                if container.Parent then
                                    for _, subChild in ipairs(container.Parent:GetChildren()) do
                                        if subChild:IsA("GuiButton") and subChild.Visible then
                                            TriggerGuiButton(subChild)
                                            clickedPurchase = true
                                            task.wait(0.2)
                                        end
                                    end
                                end
                            end
                        end
                    end
                end)
            end

            -- 3. Нажимаем кнопку подтверждения покупки (Buy / Purchase / Confirm)
            for _, btn in ipairs(pGui:GetDescendants()) do
                pcall(function()
                    if btn:IsA("GuiButton") and btn.Visible then
                        local bTxt = btn:IsA("TextButton") and string.lower(btn.Text or "") or ""
                        local bName = string.lower(btn.Name or "")
                        if bTxt == "buy" or bTxt == "purchase" or bTxt == "confirm" or string.find(bTxt, "75,000") or string.find(bTxt, "75000") or bName == "buy" or bName == "purchase" or bName == "confirm" then
                            TriggerGuiButton(btn)
                            clickedPurchase = true
                            task.wait(0.2)
                        end
                    end
                end)
            end
        end)

        return clickedPurchase
    end

    -- Цикл покупки до достижения 9 штук в инвентаре
    while currentLucky < env.YBA_Config.MaxLuckyArrows do
        local money = GetPlayerMoney()
        if not money or money < env.YBA_Config.LuckyArrowPrice then
            UI:Log(string.format("Мало денег: $%s (< 75000). Стоп.", tostring(money or 0)))
            break
        end

        local beforeLucky = currentLucky
        local guiInteracted = TryBuyViaShopGUI()

        task.wait(0.75)
        currentLucky = CountItemInInventory("Lucky Arrow")

        if currentLucky > beforeLucky then
            local diff = currentLucky - beforeLucky
            env.YBA_Stats.BoughtLucky = env.YBA_Stats.BoughtLucky + diff
            UI:UpdateStats()
            UI:Log("Куплена Lucky Arrow! (" .. tostring(currentLucky) .. "/9)")
        else
            if not guiInteracted then
                UI:Log("Ошибка: не найден товар Lucky Arrow в GUI")
            else
                UI:Log("Ошибка: покупка Lucky Arrow не прошла")
            end
            break
        end
    end
end

-- // ЭТАП 6: АВТОМАТИЧЕСКИЙ SERVER HOP ЧЕРЕЗ ПРОМЕЖУТОЧНЫЙ ПЛЕЙС //
local function PerformDeltaServerHop()
    UI:SetStatus("Server Hop...")
    UI:Log("Переход в плейс " .. tostring(env.YBA_Config.GameIDtoHopTo) .. "...")

    -- Передаём сохранённый исходный код скрипта в queue_on_teleport перед прыжком
    QueueSelfOnTeleport()

    while true do
        local ok = pcall(function()
            TeleportService:Teleport(env.YBA_Config.GameIDtoHopTo, LocalPlayer)
        end)
        if not ok then
            UI:Log("Повтор телепорта через 3с...")
        end
        task.wait(3.5)
    end
end

