local function QueueSelfOnTeleport()
    pcall(function()
        local queueFunc = queue_on_teleport 
            or (syn and syn.queue_on_teleport) 
            or (fluxus and fluxus.queue_on_teleport) 
            or (delta and delta.queue_on_teleport)
            
        if queueFunc and type(env.YBA_ScriptSource) == "string" and #env.YBA_ScriptSource > 0 then
            local bootstrapPayload = string.format(
                "local env = getgenv and getgenv() or _G\n" ..
                "env.YBA_ScriptSource = [===[%s]===]\n" ..
                "loadstring(env.YBA_ScriptSource)()",
                env.YBA_ScriptSource
            )
            queueFunc(bootstrapPayload)
        end
    end)
end

