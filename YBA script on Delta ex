-- Безопасная эмуляция клика по GUI-кнопке (все обращения внутри pcall)
local function TriggerGuiButton(btn)
    local triggered = false
    pcall(function()
        if not btn or not btn:IsA("GuiButton") then return end

        if firesignal then
            pcall(function()
                firesignal(btn.MouseButton1Click)
                firesignal(btn.Activated)
                firesignal(btn.MouseButton1Down)
                firesignal(btn.MouseButton1Up)
                triggered = true
            end)
        end

        if not triggered and getconnections then
            pcall(function()
                for _, conn in ipairs(getconnections(btn.MouseButton1Click)) do
                    conn:Fire()
                    triggered = true
                end
                for _, conn in ipairs(getconnections(btn.Activated)) do
                    conn:Fire()
                    triggered = true
                end
            end)
        end

        if not triggered and VirtualInputManager then
            pcall(function()
                local pos = btn.AbsolutePosition
                local size = btn.AbsoluteSize
                local inset = GuiService:GetGuiInset()
                local centerX = pos.X + (size.X / 2)
                local centerY = pos.Y + (size.Y / 2) + inset.Y
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, true, game, 1)
                task.wait(0.05)
                VirtualInputManager:SendMouseButtonEvent(centerX, centerY, 0, false, game, 1)
                triggered = true
            end)
        end
    end)
    return triggered
end

-- Вызов Character.RemoteEvent / RemoteFunction в YBA
local function SendYBARemote(actionType, ...)
    local args = { ... }
    local success, result = false, nil

    pcall(function()
        local character = LocalPlayer.Character
        if character then
            if actionType == "Event" and character:FindFirstChild("RemoteEvent") then
                character.RemoteEvent:FireServer(unpack(args))
                success = true
            elseif actionType == "Function" and character:FindFirstChild("RemoteFunction") then
                result = character.RemoteFunction:InvokeServer(unpack(args))
                success = true
            end
        end
    end)

    return success, result
end

-- Подсчёт количества конкретного предмета в инвентаре (Backpack + Character)
local function CountItemInInventory(itemName)
    local count = 0
    pcall(function()
        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, tool in ipairs(backpack:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == itemName then
                    count = count + 1
                end
            end
        end
        local char = LocalPlayer.Character
        if char then
            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") and tool.Name == itemName then
                    count = count + 1
                end
            end
        end
    end)
    return count
end

